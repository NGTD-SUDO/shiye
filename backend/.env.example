# 拾页后端环境变量示例 —— 复制为 .env 后按需修改

# 数据库（默认本地 backend/shiye.db）
# SHIYE_DATABASE_URL=sqlite:///./shiye.db

# JWT 密钥：生产/公网必须改成随机长字符串（≥32 位）
# 生成命令：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 写法：把上面命令输出写到 SHIYE_SECRET_KEY= 后面
# 注意：DEV_MODE=false 时若 SECRET_KEY 为空/默认值/长度<32，进程拒绝启动
SHIYE_SECRET_KEY=dev-secret-change-me

# 微信开放平台移动应用凭据（不配置时微信登录返回 503，仅 dev-login 可用）
SHIYE_WECHAT_APPID=
SHIYE_WECHAT_SECRET=

# 开发模式：true 时开放 POST /auth/dev-login 免登通道
# 生产/公网必须 false；若需内测登录，请配合下面的 INVITE_CODE 使用
SHIYE_DEV_MODE=true

# 内测邀请码：非空时 dev-login 必须带此码（常量时间比较，不匹配 → 403）
# 为空 → 本地开发免码（仅 DEV_MODE=true 时有效）
# 生成命令示例：python -c "import secrets;print(secrets.token_urlsafe(16))"
# 注意：邀请码不会出现在任何响应体/日志里
SHIYE_INVITE_CODE=

# CORS 白名单：逗号分隔的 origin 列表
# 为空 → 不注册 CORS 中间件（App 原生 HTTP 不受 CORS 影响，内测不需要开）
# 示例：SHIYE_CORS_ORIGINS=http://localhost:3000,https://shiye.example.com
# 注意：CORS 只影响浏览器（Flutter Web/调试），不影响 App 客户端
SHIYE_CORS_ORIGINS=

# 日志级别：DEBUG / INFO / WARNING / ERROR（默认 INFO）
SHIYE_LOG_LEVEL=INFO

# OCR 引擎三档取值：
#   baidu  = 百度手写 API（默认，准确率最高，按量计费约 0.005 元/次，需配 BAIDU_API_KEY/SECRET_KEY）
#   rapidocr = 本地离线免费，准确率较低，需额外装 requirements-rapidocr.txt（约 300MB 模型）
#   none   = 关闭 OCR（上传的页不会识别，启动有 WARNING）
# M0 实测结论见 docs/m0-ocr-选型结论.md
SHIYE_OCR=baidu
# OCR 请求超时秒数（百度 token 换取与识别请求共用，默认 30）
SHIYE_OCR_TIMEOUT_SECONDS=30

# 百度智能云 OCR 凭据（选 baidu 时必填）：在 https://console.bce.baidu.com/ai/ 创建文字识别应用获取
SHIYE_BAIDU_API_KEY=
SHIYE_BAIDU_SECRET_KEY=

# 图片存储目录（默认 backend/storage）
# SHIYE_STORAGE_DIR=./storage

# AI 笔记整理（DeepSeek）
SHIYE_DEEPSEEK_API_KEY=
SHIYE_DEEPSEEK_BASE_URL=https://api.deepseek.com
SHIYE_DEEPSEEK_MODEL=deepseek-chat
